                "OrgnlMsgId": org_msg_id,
                "GrpSts": grp_sts,
                "P2_xml_content": xml_content,
                "Match_Type": "Mapping_P1_P8_to_P2"
            }

# ---------------- Step 4: Update df with matching P2 on msg_id = OrgnlMsgId----------------
