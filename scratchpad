with zipfile.ZipFile(latest_zip, "r") as z:
    for p2_file_info in z.infolist():

        if not p2_file_info.filename.lower().endswith(".xml"):
            continue
        
        p2_files_list.append(f"{datetime(*p2_file_info.date_time):%Y-%m-%d %H:%M:%S}<br>{Path(p2_file_info.filename).name}")
        
        with z.open(p2_file_info) as file:
            xml_content = file.read().decode("utf-8", errors="ignore")

        org_msg_id = get_xml_value_from_string(xml_content, "OrgnlMsgId")
        grp_sts = get_xml_value_from_string(xml_content, "GrpSts") or "UNKNOWN"
        
        if org_msg_id:
            all_p2_files_details[org_msg_id] = {
