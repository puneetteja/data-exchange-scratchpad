# FIX: exact local-name match instead of endswith(), which could wrongly match
# e.g. "OrgnlMsgId" when searching for "MsgId" since "OrgnlMsgId".endswith("MsgId") is True.
def _local_name(tag: str) -> str:
    return tag.split("}")[-1]


def get_xml_value_from_string(xml_content, tag):
    try:
        root = ET.fromstring(xml_content)
        for elem in root.iter():
            if _local_name(elem.tag) == tag:
                return elem.text
    except Exception as e:
        print(f"XML parse error: {e}")
    return None


def get_xml_value_from_file(file_path, tag):
    try:
        tree = ET.parse(file_path)
        root = tree.getroot()
        for elem in root.iter():
            if _local_name(elem.tag) == tag:
                return elem.text
    except Exception as e:
        print(f"Error reading {file_path}: {e}")
    return None


def _find_child_by_localname(elem, name):
    for child in elem:
        if _local_name(child.tag) == name:
            return child
    return None


def get_reason_code_by_grpsts_xmlcontent(xml_content):
    # FIX: rewritten to match by local element name instead of a derived
    # namespace prefix. The previous version built the namespace map from
    # root.tag.split("}")[0] — if a given P2 file has no default namespace
    # on its root element, that derivation silently produces a bogus
    # namespace and every ns:-prefixed find() then matches nothing, so
    # both GrpSts and reason came back None with no error at all.
    root = ET.fromstring(xml_content)

    grp_sts_value = None
    for elem in root.iter():
        if _local_name(elem.tag) == "GrpSts":
            grp_sts_value = elem.text
            break

    # Rsn is a choice between Cd (coded reason) and Prtry (bank-specific
    # proprietary reason). AddtlInf is a separate, repeatable sibling of Rsn
    # within the same StsRsnInf block that carries free-text detail — banks
    # often populate AddtlInf even when Cd/Prtry is generic (e.g. "NARR"),
    # so without it you lose the actual human-readable explanation.
    reason_code = None
    addtl_info_parts = []

    for sts_rsn_inf in root.iter():
        if _local_name(sts_rsn_inf.tag) != "StsRsnInf":
            continue

        block_code = None
        rsn = _find_child_by_localname(sts_rsn_inf, "Rsn")
        if rsn is not None:
            cd = _find_child_by_localname(rsn, "Cd")
            if cd is not None and cd.text:
                block_code = cd.text
            else:
                prtry = _find_child_by_localname(rsn, "Prtry")
                if prtry is not None and prtry.text:
                    block_code = prtry.text

        block_addtl = [
            child.text.strip()
            for child in sts_rsn_inf
            if _local_name(child.tag) == "AddtlInf" and child.text and child.text.strip()
        ]

        # Take the first StsRsnInf block that has *either* a code or additional
        # info — don't require both, since either can appear alone.
        if block_code or block_addtl:
            reason_code = block_code
            addtl_info_parts = block_addtl
            break

    if reason_code and addtl_info_parts:
        reason = f"{reason_code} - {'; '.join(addtl_info_parts)}"
    elif reason_code:
        reason = reason_code
    elif addtl_info_parts:
        reason = "; ".join(addtl_info_parts)
    else:
        reason = None

    return grp_sts_value, reason


