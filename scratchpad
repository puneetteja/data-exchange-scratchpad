df = df.dropna(how="all")

# ✅ Ensure string type
for col in cols:
    df[col] = df[col].astype(str)

print(f'Entries in this excel file ({Path(file_path).name}) are:')
print(df)

# ============================
# STEP 1
# Finding IMBDEV tickets for which there are no IMBWEB tickets
# ============================

filtered_df = df[
    df["tts key"].str.startswith("IMBDEV", na=False) &
    ~df["related ticket (internal)"].str.contains("IMBWEB", na=False) &
    ~df["related ticket (external)"].str.contains("IMBWEB", na=False)
]

print('\nThe non-IMBWEB tickets are:')
if len(filtered_df) != 0:
    print(filtered_df)
else:
    print("No tickets found")

html_content_non_imbweb_tickets = filtered_df.to_html(index=False)
# ============================
# STEP 2, 3
# NO SCOTTY ticket
# ============================

# ✅ Extract IMBWEB ticket IDs from both columns
imbweb_from_tts = df["tts key"].str.extract(r"(IMBWEB-\d+)", expand=False)
imbweb_from_ext = df["related ticket (external)"].str.extract(r"(IMBWEB-\d+)", expand=False)
imbweb_from_int = df["related ticket (internal)"].str.extract(r"(IMBWEB-\d+)", expand=False)

# ✅ Combine into one column
df["IMBWEB_ID"] = imbweb_from_tts.fillna(imbweb_from_ext).fillna(imbweb_from_int)

# ✅ Condition: rows containing IMBWEB in the newly created column
cond_imbweb = (
    df["IMBWEB_ID"].str.contains("IMBWEB", na=False)
)

# ✅ Condition: NO SCOTTY ticket present
cond_no_scotty = ~df["client tts ticket"].str.startswith("SCOTTY", na=False)

# ✅ Apply both conditions
result_df = df[cond_imbweb & cond_no_scotty].copy()

# Filter rows where "client tts ticket" starts with "SCOTTY"
cond_scotty_ticket = df["client tts ticket"].str.startswith("SCOTTY", na=False)
scotty_ticket_df = df[cond_scotty_ticket].copy()

# Copy "client tts ticket" values into "Scotty Mapping" column
scotty_ticket_df["Scotty Mapping"] = scotty_ticket_df["client tts ticket"]

#%%%%%%%%%%%%%%
print('\nIMBWEB tickets without SCOTTY mapping:')
if len(result_df) != 0:
    print(result_df)
else:
    print("No tickets found")

# ============================
# Add SCOTTY ID column
# ============================

# ✅ SCOTTY lookup with Jira API 
def check_scotty_mapping(row):
    webkey = row["IMBWEB_ID"]

    if pd.isna(webkey) or webkey == "nan":
        return ""

    scotty_key = get_scotty_ticket(webkey)

    if scotty_key:
        return scotty_key   # ✅ return SCOTTY-xxxx
    else:
        return "NOT FOUND"

result_df["Scotty Mapping"] = result_df.apply(check_scotty_mapping, axis=1)

result_df["Scotty Mapping"] = (
    result_df["Scotty Mapping"]
    .fillna("")
    .astype(str)
)

# Concatenate scotty_ticket_df rows into result_df
result_df = pd.concat([result_df, scotty_ticket_df], ignore_index=True)

print('\nWith mapping status (based on API search in SCOTTY JIRA):')
print(result_df[["Patch name", "Subject/Summary", "IMBWEB_ID", "client tts ticket", "Scotty Mapping"]])

# ============================
# STEP 4
# ✅ Add labels with Jira API lookup of Scotty ticket
# ============================

unique_ids = result_df["Scotty Mapping"][
    result_df["Scotty Mapping"].notna() &
    ~result_df["Scotty Mapping"].str.contains("NOT FOUND", na=False)
].unique()

label_map = {
    issue_id: get_labels_for_scotty_ticket(issue_id)
    for issue_id in unique_ids
}

result_df["Labels"] = result_df["Scotty Mapping"].map(
    lambda x: ", ".join(label_map.get(x, [])) if pd.notna(x) else ""
)

pd.set_option("display.max_colwidth", None)

print('\nWith labels (based on API search in SCOTTY JIRA):')
print(result_df[["Patch name", "Subject/Summary", "IMBWEB_ID", "client tts ticket", "Scotty Mapping", "Labels"]].to_string())

# ============================
# Unique IMBWEB list
# ============================

imbweb_list = result_df.loc[
    result_df["Scotty Mapping"] == "NOT FOUND", "IMBWEB_ID"
].dropna().unique()

print("\nUnique IMBWEB tickets without SCOTTY:")
list_imbweb_list = list(imbweb_list)
print(list_imbweb_list)

