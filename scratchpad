# ✅ XML helper (handles namespaces)
def get_xml_value_from_string(xml_content, tag):
    try:
        root = ET.fromstring(xml_content)
        for elem in root.iter():
            if elem.tag.endswith(tag):
                return elem.text
    except Exception as e:
        print(f"XML parse error: {e}")
    return None


def get_xml_value_from_file(file_path, tag):
    try:
        tree = ET.parse(file_path)
        root = tree.getroot()
        for elem in root.iter():
            if elem.tag.endswith(tag):
                return elem.text
    except Exception as e:
        print(f"Error reading {file_path}: {e}")
    return None


# ✅ Step 1 + 2 → collect input files
rows = []

def process_folder(folder):
    print(f'...processing folder: {folder}')
    for f in folder.glob("*"):
        #print(f'...processing file: {f}')
        if f.name.startswith("_") or f.name.endswith(".Z"):
            continue

        file_date = datetime.fromtimestamp(f.stat().st_mtime).date()

        if file_date != today:
            continue

        msg_id = get_xml_value_from_file(f, "MsgId")
        reqd_colltn_dt = get_xml_value_from_file(f, "ReqdColltnDt") or "UNKNOWN"

        rows.append({
            "Source_File": f"{datetime.fromtimestamp(f.stat().st_mtime):%Y-%m-%d %H:%M:%S}<br>{f.name}",
            "MsgId": msg_id,
            "Pain2_File": None,
            "OrgnlMsgId": None,
            "ReqdColltnDt": reqd_colltn_dt,
            "GrpSts": None
        })

