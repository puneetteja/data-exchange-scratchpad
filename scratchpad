def split_header_and_blocks(text):
    """
    MT940 files have blocks structured as:
      {1:...}{2:...}{4:
      :20:...
      ...
      -}
    This function splits on the SWIFT envelope opener {1: at line start,
    so each block includes its envelope header + transaction fields + terminator.
    Falls back to splitting on :20: if no envelope is found.
    """
    text = text.replace("\r\n", "\n").replace("\r", "\n")

    # Try splitting on SWIFT envelope lines {1: at line start
    envelope_positions = [m.start() for m in re.finditer(r'(?m)^{1:', text)]

    if envelope_positions:
        # Find where the first envelope starts — everything before is the file header
        header = text[:envelope_positions[0]]
        if header and not header.endswith("\n"):
            header += "\n"
        body = text[envelope_positions[0]:]

        # Re-find positions within body
        starts = [m.start() for m in re.finditer(r'(?m)^{1:', body)]
        blocks = []
        for i, start in enumerate(starts):
            end = starts[i + 1] if i + 1 < len(starts) else len(body)
            blocks.append(body[start:end])
        return header, blocks

    # Fallback: no envelope, split on :20:
    match = re.search(r'(?m)^:20:', text)
    if not match:
        raise ValueError("No :20: tag found in MT940 file")

    header = text[:match.start()]
    if header and not header.endswith("\n"):
        header += "\n"
    body = text[match.start():]

    starts = [m.start() for m in re.finditer(r'(?m)^:20:', body)]
    if not starts:
        return header, [body]

    blocks = []
    for i, start in enumerate(starts):
        end = starts[i + 1] if i + 1 < len(starts) else len(body)
        blocks.append(body[start:end])
    return header, blocks
