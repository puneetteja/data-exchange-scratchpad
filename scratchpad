def delete_old_files(folder, days=30):
    cutoff = datetime.now() - timedelta(days=days)

    for file in Path(folder).rglob("*"):
        if file.is_file():
            if datetime.fromtimestamp(file.stat().st_mtime) < cutoff:
                #file.unlink()
                print(f"Deleted: {file}")

