For each row in the table with labels:
	If row: label contains "PaymentRelease" then:
		add comment to ticket "Patch deployed on UATR & <patch name - from table row>"
	If row: label does not contain "PaymentRelease" then:
		add comment to ticket "Synchronization patch <patch name - from table row> deployed on UATR"

import pandas as pd
import requests
import urllib3
from pathlib import Path
import sys
import webbrowser
import re

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

jira_token = 'haha+hoho'

def get_labels_for_scotty_ticket(issue_id):
    url = "https://jira.s-mxs.net/rest/api/2/search"

    headers = {
        "Authorization": f"Bearer {jira_token}",
        "Content-Type": "application/json"
    }

    payload = {
        "jql": f'project = 40451 AND issue = "{issue_id}"',
        "fields": ["labels"]
    }

    response = requests.post(url, json=payload, headers=headers, verify=False)

    if response.status_code != 200:
        print(f"Jira query failed for {issue_id}: {response.text}")
        return None

    data = response.json()

    issues = data.get("issues", [])
    if not issues:
        return []

    return issues[0].get("fields", {}).get("labels", [])

def get_scotty_ticket(webkey):
    url = "https://jira.s-mxs.net/rest/api/2/search"

    headers = {
        "Authorization": f"Bearer {jira_token}",
        "Content-Type": "application/json"
    }

    payload = {
        "jql": f'project = 40451 AND webkey ~ "{webkey}"',
        "fields": ["key"]
    }

    response = requests.post(url, json=payload, headers=headers, verify=False)

    if response.status_code != 200:
        print(f"Jira query failed for {webkey}")
        return None

    data = response.json()

    # ✅ Extract SCOTTY key
    if data.get("issues"):
        return data["issues"][0]["key"]

    return None

