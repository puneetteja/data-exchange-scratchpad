#!/bin/bash -x
. ~/.profile >/dev/null 2>&1

mydadat=$(date +%d/%m/%y)
mydadatum=`echo ${mydadat}|sed 's/\//_/g'`
mydadate=$(date +%d/%m/%y_%H:%M| sed 's/\(:[0-9][0-9]\)[0-9]*$/\1/' | sed 's/_/ /')
valdat=`echo ${mydadate}`
mydadat_mid=`echo ${mydadat}| sed 's/$/ 00:00/'`
if [[ `ls  /appl/tools/PK/mt940_lasttime_${mydadatum} 2>/dev/null| wc -l` -eq 0 ]]
then
rm -f /appl/tools/PK/mt940_lasttime_*
touch /appl/tools/PK/mt940_lasttime_${mydadatum}
echo ${mydadat_mid} > /appl/tools/PK/mt940_lasttime_${mydadatum}
valdatt=`cat /appl/tools/PK/mt940_lasttime_${mydadatum} | tail -n1`
else
valdatt=`cat /appl/tools/PK/mt940_lasttime_${mydadatum} | tail -n1`
fi



/imxprod/intra/mw/as/bin/sqlplus -s /@c10   <<EOF > /appl/tools/PK/mt940_err_$(date +%d-%m-%y).txt

set lines 999
set pages 9999
set colsep ";"
SET TRIMOUT ON
set trimspool on
set feedback off
set echo off
set headsep off
set underline off
SET NEWPAGE NONE
set linesize 9999
set pagesize 50000
col Interface format a20
col File format a120
col Status format a30
col Execution_Time format a30
alter session set nls_date_format='DD/MM/YY HH24:MI:SS';

select distinct
case
when interface='swift2imx' then 'MT940'
else interface
end
 Interface  , fichier as "File",  datetrait as "Execution_Time",  erreur as "Status" from t_log where  datetrait > '${valdatt}'  and interface = 'swift2imx'
  and erreur  !='TERMINATED'
  and fichier not like '%fmweb%'
order by datetrait, interface asc;

exit;
EOF


if [[ `cat  /appl/tools/PK/mt940_err_$(date +%d-%m-%y).txt | egrep -i "warning|error" | wc -l` -gt 0 ]]
then
for i in `cat /appl/tools/PK/mt940_err_$(date +%d-%m-%y).txt | egrep -i "warning|error" | awk -F";" '{print $2}'`; do ls -l $IMX_INTERFACES/swift2imx/control/${i}*; done | egrep -i "rjt|ko" | awk -F"/" '{print $8}'  > /appl/tools/PK/faulty_withsfx.txt
cat  /appl/tools/PK/faulty_withsfx.txt | awk '{print "MT940 files that were either RJT or KO ---> "$1}'  | mailx -r imxprod@erstegroup.com -s "iMX PROD - Error/Warning - MT940" -c gmopimx@erstegroup.com MLHelpdeskIMB@intermarket.at
else
echo  "no errors" >/dev/null
fi

echo ${valdat} >>/appl/tools/PK/mt940_lasttime_${mydadatum}
exit


