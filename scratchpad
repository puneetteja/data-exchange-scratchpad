from langgraph.prebuilt import create_react_agent
from langchain_openai import ChatOpenAI
from langchain_core.tools import tool

llm = ChatOpenAI(
    model="databricks-meta-llama-3-1-70b-instruct",
    base_url=f"https://{spark.conf.get('spark.databricks.workspaceUrl')}/serving-endpoints",
    api_key=dbutils.notebook.entry_point.getDbutils().notebook().getContext().apiToken().get()
)

@tool
def word_count(text: str) -> int:
    """Count the number of words in a string."""
    return len(text.split())

@tool
def reverse_text(text: str) -> str:
    """Reverse a string."""
    return text[::-1]

@tool
def get_random_weather() -> str:
    """Return a random prediction from a list of weather options."""
    import random
    my_list = [
    "Rainy",
    "Cloudy",
    "Clear",
    "Sunny",
    "Thunderstorm",
    "Snow"
    ]
    return random.choice(my_list)


# COMMAND ----------

# DBTITLE 1,Cell 5
print(word_count.invoke({'text': 'Today is a wonderful day'}))

# COMMAND ----------

# DBTITLE 1,Cell 4
print(reverse_text.invoke({'text': 'Hello there'}))

# COMMAND ----------

# DBTITLE 1,Cell 3
print(get_random_weather.invoke({}))

# COMMAND ----------

agent = create_react_agent(llm, tools=[word_count, reverse_text, get_random_weather])

# COMMAND ----------

result = agent.invoke({"messages": [{"role": "user", "content": "Count the number of words in '10 years of Erste Campus party today starts soon'."}]})
print(result["messages"][-1].content)

# COMMAND ----------

result = agent.invoke({"messages": [{"role": "user", "content": "Reverse 'Erste Group' and then count its characters only if the weather is sunny, else multiply the number of characters by 10."}]})
print(result["messages"][-1].content)

# COMMAND ----------

result = agent.invoke({"messages": [{"role": "user", "content": "Reverse 'Erste Group' and then count its characters only if the weather is sunny, else multiply the number of characters by 10."}]})
print(result["messages"][-1].content)

# COMMAND ----------

# DBTITLE 1,Cell 10
for i, msg in enumerate(result["messages"]):
    role = msg.__class__.__name__.replace("Message", "")
    print(f"[{i}] {role}")
    if hasattr(msg, "tool_calls") and msg.tool_calls:
        for tc in msg.tool_calls:
            print(f"  Tool call : {tc['name']}({tc['args']})")
    if msg.content:
        print(f"  Content   : {msg.content}")
    print()
