def build_p1p8_index(folders):
    """
    Build a dict:  MsgId -> {"P1P8_File": ..., "ReqdColltnDt": ...}
    by scanning all valid files across the given folders.
    This is done once so we don't re-read files for every unmatched P2.
    """
    index = {}
    for folder in folders:
        print(f"...indexing folder: {folder}")
        for f in folder.glob("*"):
            if not f.is_file() or f.name.startswith("_") or f.name.endswith(".Z"):
                continue
            msg_id = get_xml_value_from_file(f, "MsgId")
            if msg_id and msg_id not in index:
                reqd_colltn_dt = get_xml_value_from_file(f, "ReqdColltnDt") or "--"
                index[msg_id] = {
                    "P1P8_File": (
                        f"{datetime.fromtimestamp(f.stat().st_mtime):%Y-%m-%d %H:%M:%S}"
                        f"<br>{f.name}"
                    ),
                    "ReqdColltnDt": reqd_colltn_dt,
                }
    return index

