# ---------------- XML Helpers ----------------
def get_xml_value_from_string(xml_content, tag):
    try:
        root = ET.fromstring(xml_content)
        for elem in root.iter():
            if elem.tag.endswith(tag):
                return elem.text
    except Exception as e:
        print(f"XML parse error: {e}")
    return None

def get_xml_value_from_file(file_path, tag):
    try:
        tree = ET.parse(file_path)
        root = tree.getroot()
        for elem in root.iter():
            if elem.tag.endswith(tag):
                return elem.text
    except Exception as e:
        print(f"Error reading {file_path}: {e}")
    return None

def get_reason_code_by_grpsts_xmlcontent(xml_content):
    root = ET.fromstring(xml_content)

    # Extract namespace from root tag
    ns_uri = root.tag.split("}")[0].strip("{")
    ns = {"ns": ns_uri}

    grp_sts = root.find(".//ns:OrgnlGrpInfAndSts/ns:GrpSts", ns)
    grp_sts_value = grp_sts.text if grp_sts is not None else None

    reason = None

    for sts_rsn_inf in root.findall(".//ns:StsRsnInf", ns):
        rsn_cd = sts_rsn_inf.find("ns:Rsn/ns:Cd", ns)

        if rsn_cd is not None:
            reason = rsn_cd.text
            break

    return grp_sts_value, reason

