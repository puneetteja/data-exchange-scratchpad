def add_comment_to_scotty_ticket(issue_id, comment_text):
    url = f"https://jira.s-mxs.net/rest/api/2/issue/{issue_id}/comment"

    headers = {
        "Authorization": f"Bearer {jira_token}",
        "Content-Type": "application/json"
    }

    payload = {
        "body": comment_text
    }

    response = requests.post(url, json=payload, headers=headers, verify=False)

    if response.status_code == 201:
        print(f"  ✅ Comment added to {issue_id}")
    else:
        print(f"  ❌ Failed to add comment to {issue_id}: {response.status_code} - {response.text}")

print("\nAdding comments to SCOTTY tickets...")

for _, row in result_df.iterrows():
    scotty_id = row.get("Scotty Mapping", "")
    patch_name = row.get("Patch name", "")
    labels = row.get("Labels", "")

    # Skip rows without a valid SCOTTY ticket
    if not scotty_id or scotty_id in ("NOT FOUND", "nan", ""):
        print(f"  ⚠️  Skipping row — no valid SCOTTY ticket (Patch: {patch_name})")
        continue

    if "PaymentRelease" in str(labels):
        comment = f"Patch deployed on UATR & {patch_name}"
    else:
        comment = f"Synchronization patch {patch_name} deployed on UATR"

    print(f"  → {scotty_id} | Labels: '{labels}' | Comment: '{comment}'")
    add_comment_to_scotty_ticket(scotty_id, comment)
