import re
import sys
import os

def parse_28c(value):
    value = value.strip()
    if '/' in value:
        stmt, seq = value.split('/', 1)
        return int(stmt), int(seq)
    return int(value), 0

def split_header_and_blocks(text):
    """
    Splits MT940 into:
    - header (before first :20:, including newline)
    - statement blocks (each starting with :20:)
    """
    text = text.replace("\r\n", "\n").replace("\r", "\n")

    match = re.search(r'(?m)^:20:', text)
    if not match:
        raise ValueError("No :20: tag found in MT940 file")

    header = text[:match.start()]
    if header and not header.endswith("\n"):
        header += "\n"

    body = text[match.start():]

    # Split on newline followed by :20: — avoids DOTALL+multiline anchor issues
    raw_blocks = re.split(r'(?m)(?=^:20:)', body)
    blocks = [b for b in raw_blocks if b.strip()]

    return header, blocks

def reorder_mt940_blocks(mt940_text):
    header, blocks = split_header_and_blocks(mt940_text)

    parsed_blocks = []
    for block in blocks:
        match = re.search(r'^:28C:(.+)$', block, flags=re.MULTILINE)
        if not match:
            parsed_blocks.append(((999999, 999999), block))
            continue
        stmt_no, seq_no = parse_28c(match.group(1))
        parsed_blocks.append(((stmt_no, seq_no), block))

    parsed_blocks.sort(key=lambda x: x[0])
    return header + ''.join(block for _, block in parsed_blocks)

def read_text_file(path):
    try:
        with open(path, "r", encoding="utf-8-sig") as f:  # handles BOM automatically
            return f.read()
    except UnicodeDecodeError:
        with open(path, "r", encoding="cp1252") as f:
            return f.read()

# -------- Main --------
if __name__ == "__main__":
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <input.mt940> <output_folder>")
        sys.exit(1)

    input_file = sys.argv[1]
    output_dir = sys.argv[2]

    if not os.path.isfile(input_file):
        print(f"Error: input file not found: {input_file}")
        sys.exit(1)

    if not os.path.isdir(output_dir):
        print(f"Error: output folder not found: {output_dir}")
        sys.exit(1)

    mt940_data = read_text_file(input_file)
    reordered = reorder_mt940_blocks(mt940_data)

    input_name = os.path.basename(input_file)
    output_file = os.path.join(output_dir, f"{input_name}.reordered")

    with open(output_file, "w", encoding="utf-8") as f:
        f.write(reordered)

    print(f"Reordered MT940 written to: {output_file}")
