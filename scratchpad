# ✅ SCOTTY lookup with Jira API 
def check_scotty_mapping(row):
    webkey = row["IMBWEB_ID"]
    if pd.isna(webkey) or webkey == "nan":
        return ""
    scotty_key = get_scotty_ticket(webkey)
    if scotty_key:
        return scotty_key   # ✅ return SCOTTY-xxxx
    else:
        return "NOT FOUND"

result_df["Scotty Mapping"] = result_df.apply(check_scotty_mapping, axis=1)
result_df["Scotty Mapping"] = (
    result_df["Scotty Mapping"]
    .fillna("")
    .astype(str)
)

# Concatenate scotty_ticket_df rows into result_df
result_df = pd.concat([result_df, scotty_ticket_df], ignore_index=True)
