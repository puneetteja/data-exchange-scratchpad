print(f"Using ZIP: {latest_zip}")

# ✅ Step 4 → read ZIP WITHOUT extracting
pain2_map = {}

with zipfile.ZipFile(latest_zip, "r") as z:
    for file_info in z.infolist():

        # skip unwanted
        if file_info.filename.startswith("_") or file_info.filename.endswith(".Z"):
            continue
        
        if not file_info.filename.lower().endswith(".xml"):
            continue

        with z.open(file_info) as f:
            content = f.read()

            org_msg_id = get_xml_value_from_string(content, "OrgnlMsgId")
            grp_sts    = get_xml_value_from_string(content, "GrpSts") or "UNKNOWN"

            if org_msg_id:
                pain2_map[org_msg_id] = {
                    "file": f"{datetime(*file_info.date_time):%Y-%m-%d %H:%M:%S}<br>{Path(file_info.filename).name}",
                    "org_msg_id": org_msg_id,
                    "grp_sts": grp_sts,
                }

# ✅ Match MsgId ↔ OrgnlMsgId
for idx, row in df.iterrows():
    msg_id = row["MsgId"]

    if msg_id in pain2_map:
        print('Found MsgId in pain2map...')
