# ---------------- Step 5: Second Pass Matching (unmatched P2 → search all P1 & P8) ----------------
#
# For each P2 file that had no match in Step 4, we open it from the ZIP,
# extract its OrgnlMsgId, then scan ALL files in pain1_dir and pain8_dir
# (not restricted to today) looking for a file whose MsgId matches.

def build_p1p8_index(folders):
    """
    Build a dict:  MsgId -> {"P1P8_File": ..., "ReqdColltnDt": ...}
    by scanning all valid files across the given folders.
    This is done once so we don't re-read files for every unmatched P2.
    """
    index = {}
    for folder in folders:
        print(f"...indexing folder: {folder}")
        for f in folder.glob("*"):
            if not f.is_file() or f.name.startswith("_") or f.name.endswith(".Z"):
                continue
            msg_id = get_xml_value_from_file(f, "MsgId")
            if msg_id and msg_id not in index:
                reqd_colltn_dt = get_xml_value_from_file(f, "ReqdColltnDt") or "UNKNOWN"
                index[msg_id] = {
                    "P1P8_File": (
                        f"{datetime.fromtimestamp(f.stat().st_mtime):%Y-%m-%d %H:%M:%S}"
                        f"<br>{f.name}"
                    ),
                    "ReqdColltnDt": reqd_colltn_dt,
                }
    return index

# Build the full index once (covers all dates, both folders)
p1p8_full_index = build_p1p8_index([pain1_dir, pain8_dir])

second_pass_rows = []

with zipfile.ZipFile(latest_zip, "r") as z:
    # Build a lookup: display-string used in p2_files_list -> ZipInfo object
    zip_info_by_display = {
        (
            f"{datetime(*info.date_time):%Y-%m-%d %H:%M:%S}"
            f"<br>{Path(info.filename).name}"
        ): info
        for info in z.infolist()
        if info.filename.lower().endswith(".xml")
    }

    for p2_display in list_minus_df:
        zip_info = zip_info_by_display.get(p2_display)
        if zip_info is None:
            print(f"WARNING: could not locate ZIP entry for '{p2_display}'")
            continue

        with z.open(zip_info) as file:
            xml_content = file.read().decode("utf-8", errors="ignore")

        org_msg_id = get_xml_value_from_string(xml_content, "OrgnlMsgId")
        grp_sts    = get_xml_value_from_string(xml_content, "GrpSts") or "UNKNOWN"

        if not org_msg_id:
            print(f"WARNING: no OrgnlMsgId found in '{p2_display}' — skipping")
            continue

        match = p1p8_full_index.get(org_msg_id)

        if match:
            second_pass_rows.append({
                "P1P8_File":     match["P1P8_File"],
                "P2_File":       p2_display,
                "MsgId":         org_msg_id,
                "OrgnlMsgId":    org_msg_id,
                "ReqdColltnDt":  match["ReqdColltnDt"],
                "GrpSts":        grp_sts,
                "Match_Type":    "Mapping_P2_to_P1_P8",   # reverse-direction match
            })
            print(f"  [2nd pass] Matched P2 '{p2_display}' → P1/P8 MsgId '{org_msg_id}'")
        else:
            second_pass_rows.append({
                "P1P8_File":     None,
                "P2_File":       p2_display,
                "MsgId":         None,
                "OrgnlMsgId":    org_msg_id,
                "ReqdColltnDt":  "UNKNOWN",
                "GrpSts":        grp_sts,
                "Match_Type":    "P2_Only_No_P1_P8_Found",
            })
            print(f"  [2nd pass] No P1/P8 match for OrgnlMsgId '{org_msg_id}' in '{p2_display}'")

# Append second-pass results to the main DataFrame
if second_pass_rows:
    df_second = pd.DataFrame(second_pass_rows)
    df_base   = pd.concat([df_base, df_second], ignore_index=True)

print("===========> Final df (first pass + second pass):")
print(df_base.to_string())
